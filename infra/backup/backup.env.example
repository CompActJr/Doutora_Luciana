# Instalar na VPS em /etc/dra/backup.env, com permissão 600.
PROJECT_DIR=/opt/dra-luciana
# Repositório externo à VPS. Exemplo S3; credenciais exclusivas para backup.
RESTIC_REPOSITORY=s3:https://s3.exemplo.com/bucket/dra-luciana
RESTIC_PASSWORD_FILE=/etc/dra/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
